FROM nginx:alpine

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

RUN sed -i '/^user /d' /etc/nginx/nginx.conf \
 && sed -i 's#^pid .*;#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
 && sed -i 's/listen\s*80;/listen 8080;/; s/listen\s*\[::\]:80;/listen [::]:8080;/' /etc/nginx/conf.d/default.conf

RUN chown -R appuser:appgroup /var/cache/nginx /var/log/nginx /etc/nginx/conf.d

COPY --chown=appuser:appgroup index.html /usr/share/nginx/html/index.html

USER appuser
EXPOSE 8080
